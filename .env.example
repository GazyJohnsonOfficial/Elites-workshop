# Database: SQLite by default for zero-setup local dev. For Supabase / PostgreSQL, set:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# Admin Dashboard credentials
ADMIN_EMAIL="elitestechsolutionllc@gmail.com"
# Prefer ADMIN_PASSWORD_HASH (scrypt:<saltHex>:<derivedHex>) or set a strong ADMIN_PASSWORD in .env
ADMIN_PASSWORD="replace-with-strong-admin-password"
# ADMIN_PASSWORD_HASH=""
ADMIN_SECRET="elites-tech-jwt-secret-replace-with-random-32-chars-in-production"

# Transactional Email (Optional - if blank, emails are logged to console in dev mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Elites Tech Solutions LLC <elitestechsolutionllc@gmail.com>"
COMPANY_NOTIFICATION_EMAIL="elitestechsolutionllc@gmail.com"

# Public site configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

