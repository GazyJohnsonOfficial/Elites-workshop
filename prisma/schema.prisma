generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Registration {
  id               String   @id @default(cuid())
  reference        String   @unique
  fullName         String
  email            String
  phone            String
  country          String
  jobTitle         String
  organisation     String?
  experience       String
  tools            String?
  goals            String?
  source           String?
  privacyConsent   Boolean  @default(true)
  marketingConsent Boolean  @default(false)
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Enquiry {
  id             String   @id @default(cuid())
  reference      String   @unique
  fullName       String
  email          String
  phone          String?
  organisation   String?
  region         String
  topic          String
  message        String
  privacyConsent Boolean  @default(true)
  status         String   @default("new")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

